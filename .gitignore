# =====================================
# Python & Django .gitignore
# =====================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Django database & migrations
*.sqlite3
*.db
db.sqlite3

# Log files
*.log
django.log

# Uploads, user media & temporary files
media/
uploads/
downloads/
scratch/

# Large media & video files (exceeding or near GitHub limits)
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
reports/*.mp4
"screen recording/"
"SCREEN RECORD/"

# Archives & compressed files (> 100MB blocked by GitHub)
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.iso
"BrandCraft  Generative AI*"

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
desktop.ini
.DS_Store
